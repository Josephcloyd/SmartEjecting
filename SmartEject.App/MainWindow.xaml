<Window x:Class="SmartEject.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Smart Eject" Height="760" Width="1080" MinHeight="600" MinWidth="800" Background="#F3F6FB" WindowStartupLocation="CenterScreen"><Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="White" CornerRadius="18" Padding="22" Margin="0,0,0,22"><DockPanel><StackPanel Orientation="Horizontal"><Border Width="44" Height="44" CornerRadius="13" Background="#EAF1FF"><TextBlock Text="↥" FontSize="27" Foreground="#3975E8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="13,0"><TextBlock Text="Smart Eject" FontSize="24" FontWeight="Bold" Foreground="#182235"/><TextBlock Text="Intelligent storage manager  ·  v1.0.0" Foreground="#7A8799"/></StackPanel></StackPanel><Button DockPanel.Dock="Right" Content="Refresh devices" Click="Refresh_Click"/></DockPanel></Border>
<StackPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock Text="Connected storage" FontSize="21" FontWeight="Bold" Foreground="#182235"/><TextBlock Text="Select a removable drive to check it and request safe removal." Foreground="#7A8799" Margin="0,5,0,0"/></StackPanel>
<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="DeviceList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="16" Padding="20" Margin="0,8" BorderBrush="#E5EAF1" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="48" Height="48" CornerRadius="14" Background="#EEF4FF"><TextBlock Text="▣" FontSize="25" Foreground="#3975E8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="#182235"/><TextBlock Text="{Binding Manufacturer}" Foreground="#758197" Margin="0,3"/><TextBlock Text="{Binding DeviceType}" Foreground="#758197"/><TextBlock Text="{Binding Letters}" Foreground="#758197"/></StackPanel><Button Grid.Column="2" Content="SAFE EJECT" Tag="{Binding}" Click="Eject_Click" Padding="22,13"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
<Border Grid.Row="3" Background="White" CornerRadius="14" Padding="14" Margin="0,16,0,0"><DockPanel><TextBlock x:Name="StatusText" Text="Ready. Device discovery runs locally on this PC." Foreground="#64748B" VerticalAlignment="Center" TextWrapping="Wrap"/><ProgressBar x:Name="BusyBar" Width="120" Height="5" IsIndeterminate="True" Visibility="Collapsed" DockPanel.Dock="Right" Margin="12,0"/></DockPanel></Border></Grid></Window>

